{
  // INKWAVE online relay: one Durable Object per room code (WebSocket fan-out + membership + host election),
  // plus Lobby (public room list) and Store (accounts + cloud save).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inkwave-net",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "LOBBY", "class_name": "Lobby" }, { "name": "STORE", "class_name": "Store" }] },
  // Tags are append-only once deployed: v2 (Lobby, public room list) and v3 (Store, accounts + cloud save).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }, { "tag": "v3", "new_sqlite_classes": ["Store"] }],
  "observability": { "enabled": false }
}
